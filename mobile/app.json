{
  "expo": {
    "name": "Gomería Móvil",
    "slug": "gomeria-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para conectarte con gomeros cercanos y que puedan encontrarte."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EA580C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCWEUbeG9nkgsDWQ8DsR0oSX3_krj6uaVY"
        }
      },
      "package": "com.anonymous.gomeriamovil"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para que entres a tu cuenta sin escribir la contraseña."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para conectarte con gomeros cercanos y que puedan encontrarte."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#EA580C",
          "dark": {
            "backgroundColor": "#C2410C"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#EA580C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Usamos tus fotos para que cargues tu foto de perfil.",
          "cameraPermission": "Usamos la cámara para que te saques una foto de perfil.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d1de48b5-f628-4566-b668-6db0dcd87d83"
      }
    },
    "owner": "gonzanicoo"
  }
}
