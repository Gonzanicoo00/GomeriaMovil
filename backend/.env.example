APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/Gomeria_movil/backend/public
APP_TIMEZONE=America/Argentina/Buenos_Aires

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gomeria
DB_USERNAME=root
DB_PASSWORD=
# En la nube (Aiven/TiDB): DB_SSL=true y, si el proveedor da su propio
# certificado (Aiven), DB_SSL_CA=/etc/secrets/ca.pem
DB_SSL=false
DB_SSL_CA=
# Offset horario para NOW() en MySQL. En la nube: -03:00
DB_TIMEZONE=

JWT_SECRET=changeme
JWT_ALGO=HS256
JWT_TTL=86400
